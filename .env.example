# Postiz Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Required Secrets (auto-generated by Docker Compose substitution) ===
# Generate: openssl rand -hex 48
POSTIZ_JWT_SECRET=change-me-96-char-hex-string
# Generate: openssl rand -hex 32
POSTIZ_POSTGRES_PASSWORD=change-me-password
# Generate: openssl rand -base64 24
TEMPORAL_POSTGRES_PASSWORD=change-me-password

# === Required URLs ===
# These are set directly in docker-compose.yaml — update there if needed
# MAIN_URL: 'https://psa.innotel.us'
# FRONTEND_URL: 'https://psa.innotel.us'
# NEXT_PUBLIC_BACKEND_URL: 'https://psa.innotel.us/api'

# === Social Media API Keys ===
# Each platform requires creating an app/developer account and generating API keys.
# OAuth callback URL for all platforms: https://psa.innotel.us/api/auth/callback/<platform>

# X / Twitter — https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook / Instagram — https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# YouTube / Google — https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com/apps
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Pinterest — https://developers.pinterest.com/apps
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Reddit — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=

# Slack — https://api.slack.com/apps
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=

# Mastodon — https://mastodon.social (or your instance)
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Threads — https://developers.facebook.com/apps (Meta developer dashboard)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Dribbble — https://dribbble.com/account/applications
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Beehiive — https://app.beehiiv.com/settings/api
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=

# === AI / Misc ===
# OPENAI_API_KEY=

# === Stripe (optional) ===
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_SIGNING_KEY=
# STRIPE_SIGNING_KEY_CONNECT=
